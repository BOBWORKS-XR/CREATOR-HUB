  "expectedTests": [
    "mcp_update_handoff::tests::absent_authority_never_prepares_or_activates_even_with_a_new_signed_payload",
    "mcp_update_handoff::tests::an_unrelated_already_active_b_is_not_adopted_from_a_ready_intent",
    "mcp_update_handoff::tests::cancel_does_not_verify_publish_or_restart",
    "mcp_update_handoff::tests::changed_store_or_raw_handoff_during_install_blocks_publication",
    "mcp_update_handoff::tests::completion_hint_runs_after_both_busy_state_and_real_file_lock_are_released",
    "mcp_update_handoff::tests::correct_image_and_published_handoff_emit_pending_not_activation_success_then_restart_once",
    "mcp_update_handoff::tests::damaged_opaque_backup_is_not_repaired_or_used_to_overwrite_the_original",
    "mcp_update_handoff::tests::explicit_legacy_apply_to_bound_b_has_positive_readback_without_claiming_an_update_operation",
    "mcp_update_handoff::tests::failed_new_signature_cannot_supersede_old_bytes_or_create_a_backup",
    "mcp_update_handoff::tests::failed_target_preparation_is_also_spent_before_any_automatic_retry",
    "mcp_update_handoff::tests::fresh_publication_rechecks_actual_store_after_backup_without_rolling_it_back",
    "mcp_update_handoff::tests::fresh_publication_rechecks_old_raw_after_backup_and_never_overwrites_a_concurrent_record",
    "mcp_update_handoff::tests::fresh_signed_higher_update_supersedes_old_ready_after_explicit_apply_using_actual_current_store",
    "mcp_update_handoff::tests::fresh_signed_update_retains_owned_non_json_old_record_as_opaque_bytes",
    "mcp_update_handoff::tests::fresh_supersession_cancel_does_not_archive_or_change_old_record_or_store",
    "mcp_update_handoff::tests::fresh_update_target_must_exceed_active_hub_version_not_only_the_running_root",
    "mcp_update_handoff::tests::fresh_user_approved_update_is_not_a_retry_of_a_spent_old_attempt",
    "mcp_update_handoff::tests::image_change_after_completion_is_checked_again_immediately_before_restart",
    "mcp_update_handoff::tests::independent_current_payload_readback_does_not_adopt_an_old_ready_operation",
    "mcp_update_handoff::tests::legacy_same_version_collision_or_unreadable_route_is_unknown_not_a_safe_apply_offer",
    "mcp_update_handoff::tests::linked_or_nonprivate_handoff_and_linked_lock_refuse",
    "mcp_update_handoff::tests::malformed_or_oversize_records_do_not_invoke_the_activation_callback",
