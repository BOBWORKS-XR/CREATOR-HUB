{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finite production 016 inspection input, not native acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cohort", "mode", "assembly", "pins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cohort": { "const": "production-migration-016" },
    "mode": { "enum": ["pages", "migration-cancel"] },
    "assembly": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceCommit", "sourceTree", "runId", "runAttempt", "jobId", "artifactId", "zipBytes", "zipSha256"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/git" },
        "sourceTree": { "$ref": "#/$defs/git" },
        "runId": { "$ref": "#/$defs/id" },
        "runAttempt": { "$ref": "#/$defs/id" },
        "jobId": { "$ref": "#/$defs/id" },
        "artifactId": { "$ref": "#/$defs/id" },
        "zipBytes": { "type": "integer", "minimum": 1, "maximum": 314572800 },
        "zipSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pins": {
      "type": "object", "additionalProperties": false,
      "required": ["deb", "hub", "manifest", "modulesArchive", "assemblyReceipt", "packageIntegrity", "helper", "policy", "service", "rawHub"],
      "properties": {
        "deb": { "$ref": "#/$defs/pin" },
        "hub": { "$ref": "#/$defs/pin" },
        "manifest": { "$ref": "#/$defs/pin" },
        "modulesArchive": { "$ref": "#/$defs/pin" },
        "assemblyReceipt": { "$ref": "#/$defs/pin" },
        "packageIntegrity": { "$ref": "#/$defs/pin" },
        "helper": { "$ref": "#/$defs/pin" },
        "policy": { "$ref": "#/$defs/pin" },
        "service": { "$ref": "#/$defs/pin" },
        "rawHub": { "allOf": [{ "$ref": "#/$defs/pin" }, { "properties": { "size": { "minimum": 64 } } }] }
      }
    }
  },
  "$defs": {
    "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "git": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pin": {
      "type": "object", "additionalProperties": false, "required": ["size", "sha256"],
      "properties": {
        "size": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
