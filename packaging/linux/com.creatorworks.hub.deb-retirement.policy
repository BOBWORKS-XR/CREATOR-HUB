<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Creator Works</vendor>
  <action id="com.creatorworks.hub.deb-retirement">
    <description>Test-only Creator DEB GUI retirement</description>
    <message>Administrator authentication is required for the TEST ONLY fixed helper for verified MCP 2.7.7 or Project Setup 0.3.7 DEBs. Original MCP runtime files, user settings and Unity projects are kept.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/creator-hub-deb-retirement-helper</annotate>
  </action>
</policyconfig>
