{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creator Hub",
  "version": "0.1.9",
  "identifier": "com.creatorworks.hub",
  "build": { "frontendDist": "../src" },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IENyZWF0b3IgSHViIHJlbGVhc2UgZGVzY3JpcHRvciBrZXkgMjAyNi0wOQpSV1QrYXkrUjJnZldNWWloN1J2YkdJdWVKbC9IV0xlZklvWUFCakIyTzY4UGFEWGg0Vzd6dThWUAo=",
      "windows": { "installMode": "passive" }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Creator Hub - Development Preview", "width": 940, "height": 580, "minWidth": 560, "minHeight": 480, "center": true }],
    "security": { "csp": "default-src 'self'; frame-src 'self' about:; img-src 'self' data: blob: https://cdn.sidequestvr.com https://raw.githubusercontent.com; media-src blob:; style-src 'self' data:; script-src 'self' data:; connect-src ipc: http://ipc.localhost https://cdn.sidequestvr.com/file/ https://raw.githubusercontent.com/SideQuestVR/Creator-Community/main/" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Creator Works",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false },
      "nsis": { "installMode": "currentUser", "installerHooks": "windows/installer-hooks.nsh" }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
